# =====================================================================
# Global Superhuman Registration Authority (GHRA)
# Enterprise Production Environment Configuration Template
# =====================================================================

# Application Environment (production / staging / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ghra.agency.gov
PORT=8000

# Security & Reverse Proxy Settings
TRUST_PROXIES=false
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax

# Cryptographic Master Key for Civilian Identity Vault (AES-256)
# MANDATORY: Generate a unique high-entropy 32+ character key for production:
# Example: openssl rand -base64 32
# If omitted or left as placeholder, a secure private key is automatically generated in data/.vault_master_key
HRS_MASTER_KEY=REPLACE_WITH_UNIQUE_SECURE_CRYPTOGRAPHIC_KEY_32_BYTES

# Privileged Starter Accounts Security
# Set to 'false' or omit in production to strictly block known default passwords (admin123, registrar123)
# Set to 'true' only in local development, automated testing, or demonstration environments
ALLOW_DEFAULT_ADMIN_CREDENTIALS=false

# Third-Party Tactical Meteorological Telemetry (Optional)
OPENWEATHER_API_KEY=
OPENWEATHER_BACKUP_KEY=

# Datastore Backup Directory Configuration
BACKUP_RETENTION_DAYS=30
