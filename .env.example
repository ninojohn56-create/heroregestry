# =====================================================================
# Global Hero Registration Authority Management System (GHRMS)
# Environment Configuration
# =====================================================================

# Application Environment (production / development / testing)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
PORT=8000

# Cryptographic Master Key for Biometric Identity Vault (AES-256)
# Minimum 32-character random string in production
HRS_MASTER_KEY=HRS_SECRET_VAULT_KEY_2026_HERO_SYSTEM

# OpenWeatherMap API Key for GIS Sector Tactical Radar
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
